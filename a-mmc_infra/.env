# NOTE (B-CONFIG-1): the backend now activates ProductionConfig when
# FLASK_ENV=production is set (see a-mmc_backend/app/__init__.py). Do NOT set
# FLASK_ENV in a-mmc_backend/.env for this self-hosted docker-compose stack
# yet - ProductionConfig turns on JWT_COOKIE_SECURE, and nginx.conf here
# terminates no TLS (port 80 only), so the refresh-token cookie would be
# silently dropped by the browser and refresh would break. Leave it unset
# (or explicitly FLASK_ENV=development) until TLS is added to
# a-mmc_infra/nginx.conf - tracked as a separate follow-up under B-CONFIG-1.

NGINX_IMAGE=nginx:1.29.6-alpine
POSTGRES_IMAGE=postgres:15-alpine
# BACKEND_IMAGE=andyrews/a-mmc-backend:latest
# FRONTEND_IMAGE=andyrews/a-mmc-frontend:latest
# KIOSK_IMAGE=andyrews/a-mmc-kiosk:latest
BACKEND_IMAGE=krispybata/a-mmc-backend:latest
FRONTEND_IMAGE=krispybata/a-mmc-frontend:latest
KIOSK_IMAGE=krispybata/a-mmc-kiosk:latest


FRONTEND_CONTAINER=a-mmc-frontend
BACKEND_CONTAINER=a-mmc-backend
POSTGRES_CONTAINER=a-mmc-postgres
KIOSK_CONTAINER=a-mmc-kiosk
NGINX_CONTAINER=a-mmc-nginx

NGINX_HTTP_PORT=80
BACKEND_PORT=5000
KIOSK_PORT=7000

POSTGRES_DATA_VOLUME=a-mmc-postgres-data

NGINX_CONF_DIR=./nginx.conf

CONTAINER_INTERVAL=5s
CONTAINER_TIMEOUT=30s
CONTAINER_RETRIES=5

CPUS=0.5
MEMORY_ALLOCATION=512m
MEMORY_RESERVATION=256m


#POSTGRESQL
POSTGRES_DB=ammc_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432